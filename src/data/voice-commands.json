  "tips": [
    {
      "key": "name",
      "title": {
        "en": "Its name anywhere, or not at all",
        "fr": "Son nom n’importe où, ou pas du tout"
      },
      "detail": {
        "en": "“Wake” before, after or in the middle: “Wake, play my music”, “play my music, Wake”, “play, Wake, my music”. It hears “Wake”, “VVake”, “Ouèk” however it’s pronounced, in English or French.",
        "fr": "« Ouèk » avant, après ou au milieu : « Ouèk, mets ma musique », « mets ma musique, Ouèk », « mets, Wake, de la musique ». Il entend « Wake », « VVake », « Ouèk » quelle que soit ta prononciation, en français comme en anglais."
      },
      "examples": {
        "en": [
          "Wake, play my music",
          "Play my music, Wake",
          "Play, Wake, my music",
          "Hey Wake, skip this song"
        ],
        "fr": [
          "Ouèk, mets ma musique",
          "Mets ma musique avec Ouèk",
          "Wake, lance le yoga",
          "Mets, Wake, de la musique"
        ]
      }
    },
    {
      "key": "natural",
      "title": {
        "en": "Say it your way",
        "fr": "Dis-le à ta façon"
      },
      "detail": {
        "en": "No exact words to learn: VVake listens for what you mean. If two things fit, it asks which one.",
        "fr": "Pas de phrase à apprendre par cœur : VVake comprend ce que tu veux dire. Si deux choses collent, il te demande laquelle."
      },
      "examples": {
        "en": [
          "Can you put some music on",
          "I really want to go for a run",
          "Turn the music off",
          "Could you skip to the next track"
        ],
        "fr": [
          "Tu peux mettre un peu de musique",
          "J’veux de la musique",
          "Coupe le son",
          "Envoie du son"
        ]
      }
    },
    {
      "key": "verbs",
      "title": {
        "en": "Every sport by its verb",
        "fr": "Chaque sport par son verbe"
      },
      "detail": {
        "en": "Say what you do, the way you say it: “row”, “I’m going to lift weights”, “play tennis”. After “play”, a sport starts the workout; anything else is music.",
        "fr": "Dis ce que tu fais, comme tu le dis : « cours », « on boxe », « on va ramer », « joue au foot ». Après « joue », un sport lance la séance ; le reste, c’est de la musique."
      },
      "examples": {
        "en": [
          "Wake, row",
          "Lift weights",
          "Let’s play some football",
          "I’m going to climb",
          "Stop rowing"
        ],
        "fr": [
          "Ouèk, cours",
          "On boxe",
          "On va ramer",
          "Joue au foot",
          "Arrête de nager"
        ]
      }
    },
    {
      "key": "chain",
      "title": {
        "en": "Several commands at once",
        "fr": "Plusieurs commandes d’un coup"
      },
      "detail": {
        "en": "Link them with “and”, “then”: they run in order. A song title with “and” stays one song.",
        "fr": "Enchaîne-les avec « et », « puis », « et ensuite » : elles s’exécutent dans l’ordre. Un titre avec « et » reste un seul titre."
      },
      "examples": {
        "en": [
          "Wake up and start a run and play Radiohead",
          "Start a 30 minute run then play music"
        ],
        "fr": [
          "Wake et lance une course puis mets de la musique",
          "Lance une course et ensuite parle au coach"
        ]
      }
    }
  ],
  "siri": {
