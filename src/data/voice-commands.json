  "tips": [
    {
      "key": "name",
      "title": {
        "en": "Call it by its name, or not",
        "fr": "Appelle-le par son nom, ou pas"
      },
      "detail": {
        "en": "“Wake”, “Hey Wake”, “Wake up and…”: the name is optional and VVake hears it however it’s pronounced.",
        "fr": "« Wake », « Ouèk », « Wake et… » : le nom est facultatif et VVake le comprend quelle que soit ta prononciation."
      },
      "examples": {
        "en": [
          "Wake, start a run",
          "Hey Wake, skip this song"
        ],
        "fr": [
          "Ouèk, arrête la musique",
          "Wake, lance le yoga"
        ]
      }
    },
    {
      "key": "chain",
      "title": {
        "en": "Several commands at once",
        "fr": "Plusieurs commandes d’un coup"
      },
      "detail": {
        "en": "Link them with “and”, “then”: they run in order. A song title with “and” stays one song.",
        "fr": "Enchaîne-les avec « et », « puis », « et ensuite » : elles s’exécutent dans l’ordre. Un titre avec « et » reste un seul titre."
      },
      "examples": {
        "en": [
          "Wake up and start a run and play Radiohead",
          "Start a 30 minute run then play music"
        ],
        "fr": [
          "Wake et lance une course puis mets de la musique",
          "Lance une course et ensuite parle au coach"
        ]
      }
    }
  ],
  "siri": {
    "note": {
      "title": {
        "en": "With Siri",
        "fr": "Avec Siri"
      },
      "detail": {
        "en": "No setup: these work as soon as VVake is installed, on your iPhone, your Apple Watch and your AirPods. More actions (open a page, your daily move, a ghost challenge, postpone the Claude lock) are in the Shortcuts app.",
        "fr": "Rien à configurer : ça marche dès que VVake est installée, sur ton iPhone, ton Apple Watch et tes AirPods. D’autres actions (ouvrir une page, ton mouvement du jour, un défi fantôme, reporter le verrou Claude) sont dans l’app Raccourcis."
      },
      "name": {
        "en": "Say the app’s name like “Wake” (or “Wake Fit”): “Hey Siri, Wake skip song”.",
        "fr": "Dis le nom de l’app « Ouèk » (ou « Wake Fit ») : « Dis Siri, Ouèk coupe la musique »."
      }
    },
