{
  "name": "vvake-web",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "og": "tsx scripts/generate-og.tsx",
    "predev": "npm run og",
    "dev": "next dev",
    "prebuild": "npm run og",
    "build": "next build",
    "postbuild": "tsx scripts/csp.ts",
    "check:csp": "tsx scripts/csp.ts --check",
    "headers:cloudflare": "tsx scripts/cloudflare-headers.ts",
    "deploy:cloudflare": "npm run build && npm run headers:cloudflare && WRANGLER_SEND_METRICS=false npx --yes wrangler@4.136.0 deploy",
    "start": "npx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "npm run format:check && npm run lint && npm run typecheck && npm test",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "dependencies": {
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "d3-geo": "^3.1.1",
    "next": "16.3.6",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.3.6",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "server-only": "^0.0.1",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^7",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "VVake website: storytelling, city-unlock waitlist, rivalries and VVaker avatars."
}
