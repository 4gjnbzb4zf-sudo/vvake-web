{
  "name": "vvake-web",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@10.34.6",
  "scripts": {
    "og": "tsx scripts/generate-og.tsx",
    "predev": "pnpm run og && pnpm run maplibre && pnpm run mediapipe",
    "dev": "next dev",
    "prebuild": "pnpm run og && pnpm run maplibre && pnpm run mediapipe",
    "build": "next build",
    "postbuild": "tsx scripts/csp.ts",
    "check:csp": "tsx scripts/csp.ts --check",
    "headers:cloudflare": "tsx scripts/cloudflare-headers.ts",
    "deploy:cloudflare": "pnpm run build && pnpm run headers:cloudflare && WRANGLER_SEND_METRICS=false pnpm dlx wrangler@4.136.0 deploy",
    "start": "pnpm dlx serve out",
    "lint": "eslint",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "check": "pnpm run format:check && pnpm run lint && pnpm run typecheck && pnpm test",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "prepare": "git config core.hooksPath .githooks || true",
    "maplibre": "tsx scripts/copy-maplibre.ts",
    "mediapipe": "tsx scripts/copy-mediapipe.ts",
    "sync:stitch": "tsx scripts/sync-stitch-core.ts",
    "check:stitch": "tsx scripts/sync-stitch-core.ts --check",
    "sync:tailor": "tsx scripts/sync-tailor-core.ts",
    "check:tailor": "tsx scripts/sync-tailor-core.ts --check",
    "sync:suggest": "tsx scripts/sync-suggest-core.ts",
    "check:suggest": "tsx scripts/sync-suggest-core.ts --check",
    "sync:living": "tsx scripts/sync-living-core.ts",
    "check:living": "tsx scripts/sync-living-core.ts --check",
    "sync:coach": "tsx scripts/sync-coach-core.ts",
    "check:coach": "tsx scripts/sync-coach-core.ts --check",
    "sync:vehicle": "tsx scripts/sync-vehicle-core.ts",
    "check:vehicle": "tsx scripts/sync-vehicle-core.ts --check"
  },
  "dependencies": {
    "@mediapipe/tasks-vision": "0.10.35",
    "@noble/curves": "2.4.0",
    "@noble/hashes": "2.4.0",
    "d3-geo": "^3.1.1",
    "maplibre-gl": "6.15.0",
    "next": "16.4.3",
    "react": "19.3.1",
    "react-dom": "19.3.1",
    "topojson-client": "^3.1.0",
    "world-atlas": "^2.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/d3-geo": "^3.1.1",
    "@types/geojson": "^7946.0.16",
    "@types/node": "^22.20.4",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "@types/topojson-client": "^3.1.5",
    "@types/topojson-specification": "^1.0.5",
    "eslint": "^9",
    "eslint-config-next": "16.4.3",
    "lint-staged": "16.4.0",
    "prettier": "^3.9.10",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "server-only": "^0.0.1",
    "sharp": "0.35.5",
    "tailwindcss": "^4",
    "tsx": "^4.23.15",
    "typescript": "^5",
    "vitest": "^3.2.4"
  },
  "engines": {
    "node": ">=22"
  },
  "description": "VVake website: storytelling, city-unlock waitlist, rivalries and VVaker avatars.",
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  }
}
